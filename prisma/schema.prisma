generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admission {
  id                    String   @id @default(cuid())
  sNo                   Int?
  name                  String
  email                 String
  mobile                String
  courseName            String
  courseSlug            String?
  admissionDate         DateTime @default(now())
  status                String   @default("Enrolled") // Enrolled, Pending, Verified, Completed, Dropped
  academicCounselor     String?
  dob                   String?
  age                   Int?
  gender                String?
  maritalStatus         String?
  nationality           String?  @default("Indian")
  aadharNumber          String?
  panNumber             String?
  category              String?  @default("General")
  fatherName            String?
  fatherMobile          String?
  permanentAddress      String?
  correspondenceAddress String?
  city                  String?
  state                 String?
  pincode               String?
  courseExpectations    String?  // JSON string
  educationHistory      String?  // JSON string
  feeAmount             Float?   @default(0)
  paymentStatus         String?  @default("Paid") // Paid, Partial, Pending
  batchName             String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Course {
  id             String    @id @default(cuid())
  name           String
  slug           String    @unique
  coverImage     String?
  duration       String?
  enrolmentSeats String?
  description    String?
  badgeText      String?
  badgeBg        String?
  rating         Float?    @default(5.0)
  price          Float?    @default(0)
  category       String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Counselor {
  id                    String    @id @default(cuid())
  sNo                   Int?
  liveId                String?
  name                  String
  email                 String
  mobile                String
  password              String?
  address               String?
  city                  String?
  country               String?   @default("INDIA")
  designation           String?
  language              String?
  education             String?
  experience            String?
  specialty             String?
  specialty2            String?
  expertise             String?
  rciNumber             String?
  
  // Media & Documents
  image                 String?
  identityImage         String?
  qualificationProof    String?
  cvUrl                 String?
  
  // Banking Details
  bankName              String?
  accountNumber         String?
  ifscCode              String?
  accountType           String?
  accountHolderName     String?
  
  // Session Pricing & Status
  userType              String?   @default("Counselor")
  isApproved            Boolean   @default(true)
  isOnline              Boolean   @default(false)
  videoStatus           Boolean   @default(false)
  videoPrice            Float?    @default(0)
  audioStatus           Boolean   @default(false)
  audioPrice            Float?    @default(0)
  chatStatus            Boolean   @default(false)
  chatPrice             Float?    @default(0)
  expectedCharges       Float?    @default(0)
  councellFees          Float?    @default(0)
  commission            Float?    @default(0)
  position              Int?      @default(0)
  
  // Rich Text Bios
  about                 String?   @db.Text
  achievements          String?   @db.Text
  whatBringsYou         String?   @db.Text
  
  // System Flags
  status                String    @default("Active")
  forCourse             String?   @default("No")
  personalCounselling   String?   @default("No")
  
  // Dates
  addedOn               String?
  updatedOn             String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model Alumni {
  id                String   @id @default(cuid())
  sNo               Int?
  name              String
  email             String
  mobile            String
  image             String?
  programName       String
  certificateNumber String?
  certificateUrl    String?
  profession        String?
  skills            String?
  isOnline          Boolean  @default(true)
  status            String   @default("Active") // Active, Inactive
  isApproved        Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model CourseLead {
  id                      String    @id @default(cuid())
  sNo                     Int?
  liveId                  String?
  userId                  String?
  name                    String
  email                   String
  mobile                  String
  courseName              String
  relationshipManager     String?   @default("")
  customerSuccessManager String?   @default("")
  status                  String    @default("New") // New, Contacted, Enrolled, Inactive, Closed, Completed
  notes                   String?
  source                  String?   @default("Website")
  addedOn                 String?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}
