  pinterestLink           String?  @default("https://in.pinterest.com/counselindia")
  googlePlayAppLink       String?  @default("")
  iosAppLink              String?  @default("")

  // Contact Us Settings
  contactUsMobile         String?  @default("+91-9518241200")
  contactUsMail           String?  @default("admissions@counselindiaservices.in")
  contactUsHotline        String?  @default("+91-8930804054")
  contactUsHeadOffice     String?  @db.Text
  contactUsBranchOffice   String?  @db.Text
  contactUsHoursOperation String?  @db.Text

  // Content Settings
  aboutUs                 String?  @db.Text
  ourVision               String?  @db.Text
  privacy                 String?  @db.Text
  termsCondition          String?  @db.Text
  howCanSignup            String?  @db.Text
  refundPolicy            String?  @db.Text
  academicPolicy          String?  @db.Text
  contactUsContent        String?  @db.Text

  // Footer Settings
  footerTitle             String?  @default("Counsel India is the only practical e-learning platform for psychology and counselling programs in I")
  footerWhatsappNumber    String?  @default("+918448519298")
  footerHelplineNumber    String?  @default("+919518241200")
  footerSupportEmail      String?  @default("wecare@counselindiaservices.in")
  footerCompanyName       String?  @default("COUNSELINDIA SERVICES PRIVATE LIMITED")
  footerAddress           String?  @default("12A20, 13th Floor, E-Square , Sector 96, Noida, Uttar Pradesh 201301")
  gstNumber               String?  @default("09AAICC6447N1Z0")
  footerTwitterLink       String?  @default("https://twitter.com/counselindia1?lang=en")
  footerFbLink            String?  @default("https://www.facebook.com/counselindia/")
  instaLink               String?  @default("https://www.instagram.com/counsel_india_")
  footerYoutubeLink       String?  @default("https://www.youtube.com/channel/UCWnALe3hLVdGJzVOuEgGoYg")
  footerLinkedinLink      String?  @default("https://www.linkedin.com/company/28905636/admin/")

  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}


model InquiryLead {
  id            String   @id @default(cuid())
  sNo           Int?
  liveId        String?
  category      String   // subscription, landing-page, exit-intent, contact-us, book-session, ci-business, etc.
  name          String?
  email         String?
  mobile        String?
  countryCode   String?
  state         String?
  city          String?
  medium        String?
  source        String?
  content       String?
  message       String?  @db.Text
  hearFrom      String?
  courseType    String?
  courseName    String?
  extraData     Json?
  addedOn       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([createdAt])
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String
  role          String    @default("SUPERADMIN") // SUPERADMIN, ADMIN, COUNSELOR, STAFF
  avatar        String?
  phone         String?
  status        String    @default("Active") // Active, Inactive
  lastLoginAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([email])
}


model PersonalityTestInfo {
  id             String   @id @default(cuid())
  liveId         String?  @default("1")
  name           String   @default("Personality Test One")
  totalQuestions Int      @default(10)
  subtitle       String?  @default("Test")
  instruction    String?  @db.Text
  status         String   @default("Active")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PersonalityQuestion {
  id        String   @id @default(cuid())
  liveId    String?
  question  String   @db.Text
  answers   Json     // array of { answer: string, value: string }
  position  Int      @default(1)
  status    String   @default("Active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([position])
}

model PersonalityTabResult {
  id          String   @id @default(cuid())
  liveId      String?
  name        String
  description String   @db.Text
  points      String?
  status      String   @default("Active")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}
