  lightLogo               String?  @default("/uploads/light_logo_logo-dark-text_1640955961.png")
  favicon                 String?  @default("/uploads/favicon_favicon_favicon_1671434128_1673585969.ico")

  // Config Settings
  adminEmail              String?  @default("counselindia")
  supportEmail            String?  @default("support@counselindiaservices.in")
  helplineNumber          String?  @default("8888888888")
  whatsNumber             String?  @default("8888888888")
  emergencyNumber         String?  @default("9999999999")
  companyName             String?  @default("counselindiaAdmin")
  websiteLink             String?  @default("counselindia")
  address                 String?  @default("counselindia")
  facebookLink            String?  @default("https://www.facebook.com/profile.php?id=counselindia")
  linkedinLink            String?  @default("https://www.linkedin.com/company/counselindia")
  twitterLink             String?  @default("https://twitter.com/counselindia")
